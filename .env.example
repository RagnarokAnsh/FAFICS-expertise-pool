# =============================================================================
# FAFICS Expertise Pool — Environment Variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=fafics_db
POSTGRES_USER=fafics_user
POSTGRES_PASSWORD=fafics_password
DATABASE_URL=postgresql://fafics_user:fafics_password@localhost:5432/fafics_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── NestJS ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
JWT_SECRET=replace_with_64_char_random_string_here_for_production_use_only
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Magic Link TTLs ────────────────────────────────────────────────────────
PRESIDENT_LINK_TTL_MS=1209600000
EMAIL_VERIFY_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@fafics.org
SECRETARY_EMAIL=secretary@fafics.org

# ─── Base URLs ───────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# ─── Next.js (public — sent to browser) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Seed Data ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@fafics.org
ADMIN_PASSWORD=changeme123!

# ─── Mailhog (local dev only) ───────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN_API=https://2cf1411c8fcd694069b8635b1e393015@o4511433060777984.ingest.de.sentry.io/4511433179988048
SENTRY_DSN_WEB=https://2cf1411c8fcd694069b8635b1e393015@o4511433060777984.ingest.de.sentry.io/4511433179988048
NEXT_PUBLIC_SENTRY_DSN_WEB=https://2cf1411c8fcd694069b8635b1e393015@o4511433060777984.ingest.de.sentry.io/4511433179988048
SENTRY_ORG=fafics
SENTRY_PROJECT_WEB=fafics-web

