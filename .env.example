# =============================================================================
# FAFICS Expertise Pool — Environment Variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=fafics_db
POSTGRES_USER=fafics_user
POSTGRES_PASSWORD=fafics_password
DATABASE_URL=postgresql://fafics_user:fafics_password@localhost:5432/fafics_db

# ─── NestJS ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
JWT_SECRET=replace_with_64_char_random_string_here_for_production_use_only
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Magic Link TTLs ────────────────────────────────────────────────────────
PRESIDENT_LINK_TTL_MS=1209600000
EMAIL_VERIFY_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000

# ─── Email ───────────────────────────────────────────────────────────────────
# Transport is chosen by RESEND_API_KEY: set a real key to use Resend, otherwise
# leave it unset/commented to send via the SMTP settings below (Gmail/Mailhog).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Gmail SMTP rewrites From to the authenticated SMTP_USER account, so set this
# to that account (or a verified alias on it).
FROM_EMAIL="FAFICS <your-account@gmail.com>"
SECRETARY_EMAIL=secretary@fafics.org

# ─── Base URLs ───────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# ─── Next.js (public — sent to browser) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Seed Data ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@fafics.org
ADMIN_PASSWORD=changeme123!

# ─── SMTP (used when no real RESEND_API_KEY is set) ─────────────────────────
# Real Gmail delivery: smtp.gmail.com / 587 / Gmail account + app password.
# Local Mailhog instead: SMTP_HOST=localhost, SMTP_PORT=1025, blank user/pass.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your_16_char_app_password

