# =============================================================================
# FAFICS — BACKEND (NestJS API) production environment
# -----------------------------------------------------------------------------
# Copy this file to `.env` at the repo root on the server, then fill in the
# values marked <...>. The API reads it on startup (run from the repo root:
# `NODE_ENV=production node apps/api/dist/main`).
#
# This file is BACKEND-ONLY. The frontend's NEXT_PUBLIC_API_URL is a build-time
# value set on the machine that builds the Next.js app — see DEPLOYMENT.md.
# =============================================================================

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 16+ connection string for the server's database.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate a 64-char random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=<64_CHAR_RANDOM_STRING>
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Magic Link TTLs (milliseconds) ─────────────────────────────────────────
PRESIDENT_LINK_TTL_MS=1209600000
EMAIL_VERIFY_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000

# ─── Base URLs ───────────────────────────────────────────────────────────────
# API_BASE_URL  — public URL of this API.
# WEB_BASE_URL  — origin the browser loads the frontend from. This is the ONLY
#                 allowed CORS origin (credentials are enabled for admin login),
#                 so it MUST match wherever the frontend is actually served.
API_BASE_URL=http://<SERVER_IP_OR_DOMAIN>:3001
WEB_BASE_URL=http://<FRONTEND_HOST>:3000

# ─── Email ───────────────────────────────────────────────────────────────────
# Transport is chosen by RESEND_API_KEY: leave it UNSET (as below) to send via
# Gmail SMTP. Only set a real key if you switch back to Resend.
# RESEND_API_KEY=

# Gmail rewrites the From to the authenticated SMTP_USER account, so FROM_EMAIL
# must be that account (or a verified alias on it).
FROM_EMAIL="FAFICS <your-account@gmail.com>"
SECRETARY_EMAIL=secretary@fafics.org

# ─── SMTP (Gmail) ────────────────────────────────────────────────────────────
# SMTP_PASS is a 16-char Gmail App Password (not the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=<GMAIL_16_CHAR_APP_PASSWORD>

# ─── Seed data (first deploy only — `npx prisma db seed`) ───────────────────
# Initial admin login. Change the password immediately after first sign-in.
ADMIN_EMAIL=admin@fafics.org
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>
